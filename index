    <script>
        // CONFIGURAZIONE FIREBASE
        const firebaseConfig = {
            apiKey: "AIzaSyDhi3SRh2mDqz8_T03xYVq4XtcRiAL7IF0",
            authDomain: "cuore-d-argento.firebaseapp.com",
            databaseURL: "https://cuore-d-argento-default-rtdb.europe-west1.firebasedatabase.app",
            projectId: "cuore-d-argento",
            storageBucket: "cuore-d-argento.firebasestorage.app",
            messagingSenderId: "271690439864",
            appId: "1:271690439864:web:17b36ef2c5ab4263d3684d"
        };

        if (!firebase.apps.length) { firebase.initializeApp(firebaseConfig); }
        const database = firebase.database();

        let PIN_CORRETTO = "1234";
        let pinInserito = "";
        let volontarioCorrente = "";
        let dbRootPath = 'cuore_argento_db'; // Variabile dinamica per la sincronizzazione

        const societaInfo = {
            nome: "Associazione di Volontariato Cuore d'Argento ODV",
            sede: "Via della Stazione n. 51 – 05035 Narni Scalo (TR)",
            cfPiva: "C.F. / P.IVA: 01725470551",
            runts: "RUNTS Det. n. 870/2025 Regione Umbria",
            autorizzazione: "Aut. Esercizio n. 8642 del 19/08/2025"
        };

        let tuttiTrasporti = [], sanificazioni = [], mezzi = [], volontari = [], checklists = [], nonConformita = [];
        let offsetGiorno = 0, dateSettimana = [], idServizioAttivo = null;
        let fotoScontrinoBase64 = null;

        // --- ASCOLTO DATI DA FIREBASE (Allineato al Gestionale Desktop) ---
        database.ref('/').on('value', (snapshot) => {
            const rawData = snapshot.val() || {};
            let data = rawData;
            
            // Trova la radice corretta del database
            if (rawData.cuore_argento_db && typeof rawData.cuore_argento_db === 'object') {
                data = rawData.cuore_argento_db;
                dbRootPath = 'cuore_argento_db';
            } else {
                let altKey = Object.keys(rawData).find(k => rawData[k] && typeof rawData[k] === 'object' && (rawData[k].volontari || rawData[k].trasporti || rawData[k].mezzi));
                if (altKey) {
                    data = rawData[altKey];
                    dbRootPath = altKey;
                }
            }

            volontari = estraiDati(data.volontari);
            tuttiTrasporti = estraiDati(data.trasporti);
            sanificazioni = estraiDati(data.sanificazioni);
            mezzi = estraiDati(data.mezzi);
            checklists = estraiDati(data.checklists);
            nonConformita = estraiDati(data.nonConformita);
            
            popolaSelectLoginVolontari();
            aggiornaDropdownListe();
            
            if(document.getElementById('main-app').style.display === 'block') {
                renderServizi();
            }
        });

        // Estrattore robusto allineato al Desktop
        function estraiDati(nodo) {
            if (!nodo) return [];
            if (Array.isArray(nodo)) { return nodo.filter(item => item !== null && typeof item === 'object'); }
            if (typeof nodo === 'object') {
                return Object.keys(nodo).map(key => {
                    let item = nodo[key]; 
                    if (item && typeof item === 'object') { item.id = item.id || key; } 
                    return item;
                }).filter(item => item !== null && typeof item === 'object');
            }
            return [];
        }

        function popolaSelectLoginVolontari() {
            const select = document.getElementById('select-login-volontario');
            if(!select) return;
            let opts = '<option value="">-- Seleziona il tuo nome --</option>';
            volontari.forEach(v => {
                opts += `<option value="${v.nome}">${v.nome} (${v.ruolo || v.qualifica || 'Volontario'})</option>`;
            });
            select.innerHTML = opts;
        }

        function aggiornaVisualizzazionePin() {
            for (let i = 0; i < 4; i++) {
                const dot = document.getElementById(`dot-${i}`);
                if (i < pinInserito.length) {
                    dot.classList.add('filled');
                } else {
                    dot.classList.remove('filled');
                }
            }
        }

        function aggiungiDigit(num) {
            const selectVol = document.getElementById('select-login-volontario').value;
            if(!selectVol) { alert("Seleziona prima il tuo nome dalla lista!"); return; }
            if (pinInserito.length < 4) {
                pinInserito += num;
                aggiornaVisualizzazionePin();
                if (pinInserito.length === 4) { verificaPin(); }
            }
        }

        function cancellaDigit() {
            if (pinInserito.length > 0) {
                pinInserito = pinInserito.slice(0, -1);
                aggiornaVisualizzazionePin();
                document.getElementById('login-error').style.display = 'none';
            }
        }

        function resetPin() {
            pinInserito = "";
            aggiornaVisualizzazionePin();
            document.getElementById('login-error').style.display = 'none';
        }

        function verificaPin() {
            volontarioCorrente = document.getElementById('select-login-volontario').value;
            let volObj = volontari.find(v => v.nome === volontarioCorrente);
            
            let pinValido = PIN_CORRETTO;
            if(volObj) {
                if (volObj.pin && String(volObj.pin).trim() !== "") {
                    pinValido = String(volObj.pin);
                } else if(volObj.tel && volObj.tel.length >= 4) {
                    pinValido = volObj.tel.slice(-4);
                }
            }

            if (pinInserito === pinValido || pinInserito === PIN_CORRETTO) {
                document.getElementById('login-screen').style.display = 'none';
                document.getElementById('main-app').style.display = 'block';
                document.getElementById('fab-container').style.display = 'flex';
                
                document.getElementById('tessera-nome').innerText = volontarioCorrente;
                
                if(volObj) {
                    document.getElementById('tessera-ruolo').innerText = volObj.ruolo || volObj.qualifica || 'Volontario';
                    document.getElementById('tessera-id').innerText = volObj.id || 'N/D';
                    
                    const imgEl = document.getElementById('tessera-foto');
                    if (volObj.foto) { imgEl.src = volObj.foto; } else { imgEl.src = 'https://via.placeholder.com/150'; }
                    
                    let statoQuotaTesto = "IN REGOLA";
                    let coloreQuota = "var(--success)";
                    if (volObj.quota) {
                        const diff = Math.ceil((new Date(volObj.quota) - new Date()) / (1000 * 60 * 60 * 24));
                        if (diff < 0) { statoQuotaTesto = "SCADUTA"; coloreQuota = "var(--danger)"; }
                    }
                    const quotaEl = document.getElementById('tessera-stato-quota');
                    quotaEl.innerText = statoQuotaTesto;
                    quotaEl.style.color = coloreQuota;
                    
                    const qrContainer = document.getElementById('qrcode-container-mobile');
                    if (qrContainer) {
                        qrContainer.innerHTML = "";
                        let urlVerifica = "https://tuo-dominio.netlify.app/?verify=" + volObj.id; 
                        setTimeout(() => {
                            try { new QRCode(qrContainer, { text: urlVerifica, width: 100, height: 100, correctLevel: QRCode.CorrectLevel.L }); } catch(e) {}
                        }, 100);
                    }
                }

                showToast(`Benvenuto, ${volontarioCorrente}`);
                inizializzaAppDati();
            } else {
                document.getElementById('login-error').style.display = 'block';
                setTimeout(resetPin, 800);
            }
        }

        function eseguiLogout() {
            pinInserito = "";
            volontarioCorrente = "";
            aggiornaVisualizzazionePin();
            document.getElementById('main-app').style.display = 'none';
            document.getElementById('fab-container').style.display = 'none';
            document.getElementById('login-screen').style.display = 'flex';
            showToast("App bloccata in sicurezza");
        }

        function apriTesseraVolontario() { document.getElementById('modal-tessera').classList.add('active'); }
        function chiudiTesseraVolontario() { document.getElementById('modal-tessera').classList.remove('active'); }

        function inizializzaAppDati() {
            const opzioniData = { weekday: 'long', day: 'numeric', month: 'long' };
            document.getElementById('data-header').innerText = new Date().toLocaleDateString('it-IT', opzioniData);
            
            const oggiIso = getDataStr(0);
            document.getElementById('san-data').value = oggiIso;
            document.getElementById('svz-data').value = oggiIso;
            document.getElementById('dia-inizio').value = oggiIso;
            document.getElementById('nc-data').value = oggiIso;
            
            let now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('chk-data').value = now.toISOString().slice(0,16);

            inizializzaCalendario();
            renderServizi();
            initGooglePlacesAutocomplete();
        }

        function initGooglePlacesAutocomplete() {
            if (typeof google === 'undefined' || !google.maps || !google.maps.places) return;
            const inputs = document.querySelectorAll('.google-autocomplete');
            inputs.forEach(input => {
                if (input.dataset.autocompleteInitialized) return;
                input.addEventListener('input', (e) => { if (e.target.value.includes('!')) { e.target.value = e.target.value.replace(/!/g, ''); } });
                const autocomplete = new google.maps.places.Autocomplete(input, { componentRestrictions: { country: "it" }, fields: ["formatted_address", "name"] });
                autocomplete.addListener('place_changed', () => {
                    const place = autocomplete.getPlace();
                    let val = place.formatted_address || place.name || '';
                    input.value = val.replace(/!/g, '');
                });
                input.dataset.autocompleteInitialized = "true";
            });
        }

        function inizializzaCalendario() {
            const tabsContainer = document.getElementById('day-tabs-container');
            tabsContainer.innerHTML = '';
            dateSettimana = [];
            for (let i = 0; i < 7; i++) {
                let dIso = getDataStr(i);
                dateSettimana.push(dIso);
                let d = new Date(dIso);
                let nomeGiorno = i === 0 ? "Oggi" : (i === 1 ? "Domani" : d.toLocaleDateString('it-IT', { weekday: 'short' }).replace('.', ''));
                nomeGiorno = nomeGiorno.charAt(0).toUpperCase() + nomeGiorno.slice(1);
                let etichetta = `${nomeGiorno} ${d.getDate()} ${d.toLocaleDateString('it-IT', { month: 'short' }).replace('.', '')}`;
                tabsContainer.innerHTML += `<div class="toggle-btn ${i === 0 ? 'active' : ''}" id="tab-${i}" onclick="cambiaGiorno(${i})">${etichetta}</div>`;
            }
        }

        function cambiaGiorno(indice) {
            offsetGiorno = indice;
            document.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + indice).classList.add('active');
            renderServizi();
        }

        function getDataStr(aggiungiGiorni = 0) {
            let d = new Date(); d.setDate(d.getDate() + aggiungiGiorni);
            d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().split('T')[0];
        }

        function aggiornaDropdownListe() {
            let optMezzi = '<option value="">-- Seleziona --</option>';
            mezzi.forEach(m => optMezzi += `<option value="${m.nome} (${m.targa})">${m.nome} - ${m.targa}</option>`);
            document.querySelectorAll('.select-mezzi').forEach(el => el.innerHTML = optMezzi);

            let optVol = '<option value="">-- Seleziona --</option>';
            volontari.forEach(v => optVol += `<option value="${v.nome}">${v.nome}</option>`);
            document.querySelectorAll('.select-volontari').forEach(el => el.innerHTML = optVol);
            
            if(volontarioCorrente) {
                document.querySelectorAll('.select-volontari').forEach(el => {
                    if(!el.value) el.value = volontarioCorrente;
                });
            }
        }

        function renderServizi() {
            const container = document.getElementById('lista-servizi');
            if(!container) return;
            container.innerHTML = '';
            const dataFiltro = dateSettimana[offsetGiorno], dataOggi = dateSettimana[0];
            let serviziGiorno = tuttiTrasporti.filter(t => t.data === dataFiltro).sort((a, b) => (a.ora > b.ora) ? 1 : -1);

            if (serviziGiorno.length === 0) {
                container.innerHTML = `<div class="empty-state"><i class="fa-solid fa-mug-hot"></i><h3>Nessun Servizio</h3><p>Non ci sono viaggi programmati per questa data.</p></div>`; return;
            }

            serviziGiorno.forEach(t => {
                let chiuso = (t.stato === 'Completato' || t.stato === 'Da Rendicontare' || t.statoServizio === 'Completato' || t.statoServizio === 'Da Rendicontare');
                
                let htmlPulsante = chiuso ? `<div class="status-done"><i class="fa-solid fa-check-double"></i> Concluso ${t.oraChiusura ? 'alle '+t.oraChiusura : ''}</div>` : 
                                  (dataFiltro === dataOggi ? `<button class="btn-action" onclick="apriPannelloChiusura('${t.id}')"><i class="fa-solid fa-flag-checkered"></i> Chiudi Servizio</button>` : 
                                  `<div class="status-locked"><i class="fa-solid fa-lock"></i> Chiudibile il ${new Date(dataFiltro).toLocaleDateString('it-IT')}</div>`);

                let ic = t.regime && t.regime.toLowerCase().includes('asl') ? 'fa-file-medical' : 'fa-hand-holding-dollar';
                
                // Pulsante Esportazione Calendario Mobile
                let btnCalendar = `<button type="button" onclick="generaICSMobile('${t.id}')" style="background:var(--warning); color:white; border:none; padding:6px; border-radius:8px; font-size:0.75rem; font-weight:700; box-shadow: 0 4px 10px rgba(245,158,11,0.3); cursor:pointer; margin-top:6px; width:100%; display:flex; align-items:center; justify-content:center; gap:6px;"><i class="fa-regular fa-calendar-plus"></i> Cal</button>`;

                container.innerHTML += `
                    <div class="card ${chiuso ? 'chiuso' : ''}">
                        <div class="card-top">
                            <div style="display:flex; flex-direction:column; align-items:center; min-width: 60px;">
                                <div class="time-badge">${t.ora}</div>
                                ${!chiuso ? btnCalendar : ''}
                            </div>
                            <div style="flex:1; padding-left:12px;">
                                <div class="regime-label"><i class="fa-solid ${ic}"></i> ${t.regime || 'Privato'}</div>
                                <div class="patient-name">${t.paziente}</div>
                            </div>
                        </div>
                        <div class="divider"></div>
                        <div class="route">
                            <div class="route-point"><div class="icon-col"><i class="fa-regular fa-circle-dot" style="color:var(--info)"></i><div class="line"></div></div><div class="text-col"><span>Partenza</span><strong>${t.partenza}</strong></div></div>
                            <div class="route-point"><div class="icon-col"><i class="fa-solid fa-location-dot" style="color:var(--primary)"></i></div><div class="text-col"><span>Destinazione</span><strong>${t.destinazione}</strong></div></div>
                        </div>
                        <div class="crew-info"><div><i class="fa-solid fa-truck-medical"></i> ${t.mezzo || t.mezzoSelezionato || 'N/D'}</div><div><i class="fa-solid fa-users"></i> ${t.autista || t.autistaSelezionato || '-'} &bull; ${t.soccorritore || t.soccorritoreSelezionato || '-'}</div></div>
                        ${htmlPulsante}
                    </div>`;
            });
        }

        // --- FIRMA DIGITALE & SCONTRINO ---
        let signatureCtx, signatureCanvas, isDrawing = false;
        
        function initFirma() {
            signatureCanvas = document.getElementById('signature-pad');
            signatureCtx = signatureCanvas.getContext('2d');
            const rect = signatureCanvas.getBoundingClientRect();
            signatureCanvas.width = rect.width;
            signatureCanvas.height = rect.height;
            signatureCtx.lineWidth = 3; signatureCtx.lineCap = 'round'; signatureCtx.strokeStyle = '#1e293b';

            const getPos = (e) => {
                const rect = signatureCanvas.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                return { x: clientX - rect.left, y: clientY - rect.top };
            };

            const start = (e) => { e.preventDefault(); isDrawing = true; const pos = getPos(e); signatureCtx.beginPath(); signatureCtx.moveTo(pos.x, pos.y); };
            const draw = (e) => { e.preventDefault(); if(!isDrawing) return; const pos = getPos(e); signatureCtx.lineTo(pos.x, pos.y); signatureCtx.stroke(); };
            const stop = () => { isDrawing = false; };

            signatureCanvas.addEventListener('mousedown', start);
            signatureCanvas.addEventListener('mousemove', draw);
            signatureCanvas.addEventListener('mouseup', stop);
            signatureCanvas.addEventListener('mouseout', stop);
            signatureCanvas.addEventListener('touchstart', start, {passive: false});
            signatureCanvas.addEventListener('touchmove', draw, {passive: false});
            signatureCanvas.addEventListener('touchend', stop);
        }

        window.pulisciFirma = () => { if(signatureCtx && signatureCanvas) signatureCtx.clearRect(0, 0, signatureCanvas.width, signatureCanvas.height); };

        function isCanvasBlank(canvas) {
            const blank = document.createElement('canvas'); blank.width = canvas.width; blank.height = canvas.height; return canvas.toDataURL() === blank.toDataURL();
        }

        document.getElementById('foto-upload').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if(!file) return;
            const btnLabel = document.getElementById('lbl-foto');
            btnLabel.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Elaborazione...';
            
            const reader = new FileReader();
            reader.onload = function(event) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const MAX_WIDTH = 800;
                    const scaleSize = MAX_WIDTH / img.width;
                    canvas.width = MAX_WIDTH;
                    canvas.height = img.height * scaleSize;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    fotoScontrinoBase64 = canvas.toDataURL('image/jpeg', 0.6);
                    
                    btnLabel.innerHTML = '<i class="fa-solid fa-check"></i> Scontrino Caricato';
                    btnLabel.classList.add('loaded');
                }
                img.src = event.target.result;
            }
            reader.readAsDataURL(file);
        });

        window.apriPannelloChiusura = (id) => {
            const t = tuttiTrasporti.find(x => String(x.id) === String(id));
            if (!t) return;
            idServizioAttivo = id;
            document.getElementById('sheet-patient-name').innerText = `${t.paziente}\nDa: ${t.partenza}`;
            let kmSuggeriti = Math.max(0, (parseFloat(t.kmArrivo) || 0) - (parseFloat(t.kmPartenza) || 0));
            document.getElementById('km-input').value = kmSuggeriti > 0 ? kmSuggeriti : '';
            
            fotoScontrinoBase64 = null;
            document.getElementById('lbl-foto').innerHTML = '<i class="fa-solid fa-camera"></i> Allega Scontrino';
            document.getElementById('lbl-foto').classList.remove('loaded');
            
            document.getElementById('overlay').classList.add('active');
            document.getElementById('bottomSheet').classList.add('active');
            setTimeout(() => { initFirma(); }, 400);
        };

        window.chiudiModaleBottomSheet = () => {
            document.getElementById('overlay').classList.remove('active');
            document.getElementById('bottomSheet').classList.remove('active');
            idServizioAttivo = null;
        };

        window.confermaChiusura = () => {
            if (!idServizioAttivo) return;
            const kmFinali = document.getElementById('km-input').value;
            if (kmFinali === "" || kmFinali < 0) { alert("Inserisci i chilometri di fine viaggio."); return; }

            const t = tuttiTrasporti.find(x => String(x.id) === String(idServizioAttivo));
            t.kmPartenza = 0;
            t.kmArrivo = parseFloat(kmFinali) || 0;
            if(fotoScontrinoBase64) t.fotoScontrino = fotoScontrinoBase64;
            if(signatureCanvas && !isCanvasBlank(signatureCanvas)) { t.firma = signatureCanvas.toDataURL('image/png'); }
            t.oraChiusura = new Date().toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' });
            
            t.statoServizio = t.regime.toLowerCase().includes('asl') ? "Da Rendicontare" : "Completato";
            t.stato = t.statoServizio;
            
            chiudiModaleBottomSheet();
            database.ref(dbRootPath + '/trasporti').set(tuttiTrasporti).then(() => { showToast('Servizio chiuso e archiviato!'); });
        };

        window.toggleFab = () => { document.getElementById('fab-container').classList.toggle('active'); document.getElementById('fab-overlay').classList.toggle('active'); };
        window.apriPagina = (pageId) => { toggleFab(); document.getElementById(pageId).classList.add('active'); setTimeout(initGooglePlacesAutocomplete, 300); };
        window.chiudiPagina = (pageId) => { document.getElementById(pageId).classList.remove('active'); };

        // --- SALVATAGGI MODULI SU FIREBASE ---
        window.salvaChecklistMobile = (e) => {
            e.preventDefault();
            const obj = { id: Date.now(), data: document.getElementById('chk-data').value, mezzo: document.getElementById('chk-mezzo').value, autista: document.getElementById('chk-autista').value, km: document.getElementById('chk-km').value, carburante: document.getElementById('chk-carburante').value };
            checklists.push(obj);
            database.ref(dbRootPath + '/checklists').set(checklists).then(() => { chiudiPagina('page-checklist'); document.getElementById('form-checklist').reset(); showToast('Checklist salvata!'); });
        };

        window.salvaSanificazioneMobile = (e) => {
            e.preventDefault();
            sanificazioni.push({ id: Date.now(), data: document.getElementById('san-data').value, mezzo: document.getElementById('san-mezzo').value, operatore: document.getElementById('san-operatore').value, tipo: document.getElementById('san-tipo').value });
            database.ref(dbRootPath + '/sanificazioni').set(sanificazioni).then(() => { chiudiPagina('page-sanificazione'); document.getElementById('form-sanificazione').reset(); showToast('Sanificazione salvata!'); });
        };

        window.salvaServizioMobile = (e) => {
            e.preventDefault();
            tuttiTrasporti.push({ id: Date.now(), data: document.getElementById('svz-data').value, ora: document.getElementById('svz-ora').value, paziente: document.getElementById('svz-paziente').value, regime: document.getElementById('svz-regime').value, partenza: document.getElementById('svz-partenza').value, destinazione: document.getElementById('svz-destinazione').value, mezzoSelezionato: document.getElementById('svz-mezzo').value, mezzo: document.getElementById('svz-mezzo').value, statoServizio: "Programmato", stato: "Programmato", kmPartenza: 0, kmArrivo: 0 });
            database.ref(dbRootPath + '/trasporti').set(tuttiTrasporti).then(() => { chiudiPagina('page-servizio'); document.getElementById('form-servizio').reset(); showToast('Servizio creato!'); });
        };

        window.salvaDialisiMobile = (e) => {
            e.preventDefault();
            const p = document.getElementById('dia-paziente').value, cf = document.getElementById('dia-cf') ? document.getElementById('dia-cf').value.toUpperCase() : "", mz = document.getElementById('dia-mezzo').value, ptz = document.getElementById('dia-partenza').value, arr = document.getElementById('dia-destinazione').value;
            const dIn = new Date(document.getElementById('dia-inizio').value), dFi = new Date(document.getElementById('dia-fine').value);
            if(dFi < dIn) return alert("Data fine precedente all'inizio!");
            let curr = new Date(dIn); let count = 0;
            while(curr <= dFi) {
                if([1,3,5].includes(curr.getDay())) {
                    curr.setMinutes(curr.getMinutes() - curr.getTimezoneOffset()); let dStr = curr.toISOString().split('T')[0];
                    tuttiTrasporti.push({ id: Date.now() + count++, regime: "Convenzione ASL Umbria 2 (Dialisi)", paziente: p, cf: cf, data: dStr, ora: "07:00", partenza: ptz, destinazione: arr, mezzoSelezionato: mz, mezzo: mz, statoServizio: "Programmato", stato: "Programmato", kmPartenza: 0, kmArrivo: 15 });
                }
                curr.setDate(curr.getDate() + 1);
            }
            database.ref(dbRootPath + '/trasporti').set(tuttiTrasporti).then(() => { chiudiPagina('page-dialisi'); showToast(`Generati ${count} viaggi dialisi!`); });
        };

        window.salvaNCMobile = (e) => {
            e.preventDefault();
            nonConformita.push({ id: Date.now(), data: document.getElementById('nc-data').value, rilevatore: document.getElementById('nc-rilevatore').value, tipo: document.getElementById('nc-tipo').value, descrizione: document.getElementById('nc-descrizione').value, stato: 'Aperta' });
            database.ref(dbRootPath + '/nonConformita').set(nonConformita).then(() => { chiudiPagina('page-nc'); document.getElementById('form-nc-mobile').reset(); showToast('Segnalazione NC inviata!'); });
        };

        window.stampaReportGiornalieroPDF = () => {
            const { jsPDF } = window.jspdf; const doc = new jsPDF('p', 'mm', 'a4');
            const dataFiltroCorrente = dateSettimana[offsetGiorno]; const dataFormattata = new Date(dataFiltroCorrente).toLocaleDateString('it-IT');

            doc.setFontSize(12); doc.setTextColor(139, 92, 246); doc.text(societaInfo.nome, 14, 15);
            doc.setFontSize(8); doc.setTextColor(100, 100, 100); doc.text(`${societaInfo.sede} | ${societaInfo.cfPiva}`, 14, 20); doc.text(`${societaInfo.runts} | ${societaInfo.autorizzazione}`, 14, 24);
            doc.setFontSize(10); doc.setTextColor(0, 0, 0); doc.text(`REPORT OPERATIVO GIORNALIERO - Data: ${dataFormattata}`, 14, 32); doc.text(`Operatore in servizio: ${volontarioCorrente}`, 14, 37);
            doc.line(14, 40, 196, 40);

            let serviziGiorno = tuttiTrasporti.filter(t => t.data === dataFiltroCorrente).sort((a, b) => (a.ora > b.ora) ? 1 : -1);
            let bodyData = serviziGiorno.map(t => [t.ora, t.paziente, t.regime, t.partenza + ' ➔ ' + t.destinazione, t.mezzo || t.mezzoSelezionato, t.stato || t.statoServizio]);
            
            if(bodyData.length === 0) { bodyData = [["-", "Nessun servizio programmato per questa data", "-", "-", "-", "-"]]; }

            doc.autoTable({ startY: 43, head: [['Ora', 'Paziente', 'Regime', 'Tratta', 'Mezzo', 'Stato']], body: bodyData, theme: 'grid', headStyles: { fillColor: [139, 92, 246] }, styles: { fontSize: 8 } });
            let finalY = doc.lastAutoTable.finalY + 15; doc.setFontSize(9); doc.text("Firma Operatore / Autista: ______________________", 14, finalY); doc.text("Firma Responsabile: ______________________", 110, finalY);

            doc.save(`Report_Giornaliero_${dataFormattata.replace(/\//g, '-')}.pdf`); showToast('Report PDF Giornaliero Generato!');
        };
        
        // --- FUNZIONE PER AGGIUNGERE EVENTO AL CALENDARIO MOBILE (.ics) ---
        window.generaICSMobile = function(id) {
            const t = tuttiTrasporti.find(x => String(x.id) === String(id));
            if (!t) return;
            
            let titolo = 'Servizio CdA: ' + t.paziente;
            let descrizione = 'Regime: ' + t.regime + '\\nPartenza: ' + t.partenza + '\\nDestinazione: ' + t.destinazione + '\\nMezzo: ' + (t.mezzoSelezionato || t.mezzo || 'Da definire');
            let location = t.partenza;
            
            function formatICSDate(dataStr, oraStr, oreAggiuntive) {
                let d = new Date(dataStr + 'T' + (oraStr || '08:00') + ':00');
                d.setHours(d.getHours() + oreAggiuntive);
                let pad = n => (n < 10 ? '0' : '') + n;
                return d.getUTCFullYear() + pad(d.getUTCMonth()+1) + pad(d.getUTCDate()) + 'T' + 
                       pad(d.getUTCHours()) + pad(d.getUTCMinutes()) + pad(d.getUTCSeconds()) + 'Z';
            }
            
            let inizioStr = formatICSDate(t.data, t.ora, 0);
            let fineStr = formatICSDate(t.data, t.ora, 2); // Stima standard di 2 ore
            
            const icsContent = `BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//Cuore d'Argento//Mobile//IT\nBEGIN:VEVENT\nUID:${Date.now()}@cuoredargento.it\nDTSTAMP:${inizioStr}\nDTSTART:${inizioStr}\nDTEND:${fineStr}\nSUMMARY:${titolo}\nDESCRIPTION:${descrizione}\nLOCATION:${location}\nEND:VEVENT\nEND:VCALENDAR`;

            const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
            const link = document.createElement('a');
            link.href = window.URL.createObjectURL(blob);
            link.download = titolo.replace(/[^a-z0-9]/gi, '_').toLowerCase() + '.ics';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            showToast("Aperto nel Calendario!");
        };

        window.scaricaTesseraPDFMobile = () => {
            let v = volontari.find(vol => vol.nome === volontarioCorrente);
            if(!v) { alert("Errore nel recupero dati volontario."); return; }
            
            try {
                const { jsPDF } = window.jspdf; const doc = new jsPDF('p', 'mm', [86, 54]); 
                doc.setFillColor(139, 92, 246); doc.rect(0, 0, 54, 18, 'F'); doc.setTextColor(255, 255, 255); doc.setFontSize(10); doc.setFont("helvetica", "bold");
                let nomeEnte = "CUORE D'ARGENTO ODV"; let splitTitle = doc.splitTextToSize(nomeEnte, 50); doc.text(splitTitle, 27, 8, { align: 'center' });
                doc.setFontSize(5.5); doc.setFont("helvetica", "normal"); doc.text("TESSERA DI RICONOSCIMENTO", 27, 14, { align: 'center' }); doc.text("Ai sensi del D.Lgs. 81/08 e s.m.i.", 27, 16.5, { align: 'center' });
                if (v.foto) { try { doc.addImage(v.foto, 'JPEG', 17, 22, 20, 25); doc.setDrawColor(139, 92, 246); doc.setLineWidth(0.5); doc.rect(17, 22, 20, 25); } catch(e) {} } else { doc.setDrawColor(200, 200, 200); doc.setFillColor(240, 240, 240); doc.rect(17, 22, 20, 25, 'FD'); doc.setTextColor(150, 150, 150); doc.setFontSize(8); doc.text("FOTO", 27, 35, { align: 'center' }); }
                doc.setTextColor(0, 0, 0); doc.setFontSize(10); doc.setFont("helvetica", "bold"); doc.text(v.nome || "Nome Non Inserito", 27, 53, { align: 'center' });
                doc.setFontSize(7); doc.setFont("helvetica", "normal"); doc.setTextColor(100, 100, 100); doc.text("Qualifica / Ruolo Operativo:", 27, 58, { align: 'center' });
                doc.setFontSize(9); doc.setFont("helvetica", "bold"); doc.setTextColor(139, 92, 246); doc.text(v.ruolo || v.qualifica || "Volontario", 27, 62, { align: 'center' });
                doc.setFontSize(6.5); doc.setTextColor(0, 0, 0); doc.setFont("helvetica", "normal"); doc.text("Matricola / ID: " + (v.id || "000"), 4, 73);
                let validitaStr = (v.quota) ? new Date(v.quota).toLocaleDateString('it-IT') : "Illimitata"; doc.text("Scadenza: " + validitaStr, 4, 77);
                doc.setDrawColor(0, 0, 0); doc.setLineWidth(0.2); doc.line(28, 80, 50, 80); doc.setFontSize(5); doc.text("Firma del Titolare", 39, 83, { align: 'center' });
                doc.save('Tessera_' + (v.nome || 'ID').replace(/\s+/g, '_') + '.pdf'); showToast("Tessera scaricata!");
            } catch(e) { alert("Errore generazione PDF."); }
        };

        function showToast(m) { const t = document.getElementById('toast'); document.getElementById('toast-msg').innerText = m; t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 3500); }
    </script>
